# Base de datos PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/panaderia_dev"

# Secreto JWT para autenticación
JWT_SECRET="tu-secreto-muy-largo-y-aleatorio-aqui-minimo-32-caracteres"

# Puerto del servidor
PORT=5000

# Ambiente
NODE_ENV=development

# Almacenamiento de imágenes en Cloudinary
CLOUDINARY_CLOUD_NAME="tu-cloud-name"
CLOUDINARY_API_KEY="tu-api-key"
CLOUDINARY_API_SECRET="tu-api-secret"
# Opcional; por defecto se usa "panaderia"
CLOUDINARY_FOLDER="panaderia"

# Credenciales para crear el administrador inicial mediante `npm run seed`
ADMIN_EMAIL="admin@panaderia.com"
ADMIN_PASSWORD="elegi-una-contrasena-segura"
